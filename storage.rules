rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.prefs.role == 'admin' ||
         ('labels' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
          'admin' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.labels))
      );
    }

    // Product images, slides, category cover images (Admin write/delete, Public read)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin() &&
        (request.resource == null || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // General images folder (Public read, authenticated upload <10MB)
    match /images/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthenticated() &&
        (request.resource == null || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    // Customer review images (Public read, authenticated upload <10MB)
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // Catch-all fallthrough
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        (request.resource == null || (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
