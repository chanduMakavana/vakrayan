# ==============================================================================
# VAKRAYAN — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ==============================================================================

# ─── Firebase Configuration (Client-Side — secured by Firestore rules) ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# ─── Firebase Collection IDs ─────────────────────────────────────────────────
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_PRODUCTS_COLLECTION_ID=products
VITE_FIREBASE_CART_COLLECTION_ID=cart
VITE_FIREBASE_ORDERS_COLLECTION_ID=orders
VITE_FIREBASE_COUPONS_COLLECTION_ID=coupons
VITE_FIREBASE_ADDRESSES_COLLECTION_ID=addresses
VITE_FIREBASE_REVIEWS_COLLECTION_ID=reviews
VITE_FIREBASE_SETTINGS_COLLECTION_ID=settings
VITE_FIREBASE_SLIDES_COLLECTION_ID=slides

# ─── Razorpay (Client-Side — public key only) ────────────────────────────────
VITE_RAZORPAY_KEY_ID=
VITE_RAZORPAY_VERIFY_URL=

# ─── Admin Configuration ─────────────────────────────────────────────────────
VITE_ADMIN_EMAIL=

# ─── Discord Webhooks (Client-Side — fire-and-forget notifications) ──────────
VITE_ORDER_WEBHOOK_URL=
VITE_EVENT_WEBHOOK_URL=
VITE_CANCEL_WEBHOOK_URL=

# ─── Telegram (Client-Side — used only for direct API calls on localhost) ────
# NOTE: In production, Telegram messages go through the Netlify serverless
# function at /.netlify/functions/telegram which reads server-only env vars.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
VITE_TELEGRAM_ORDER_CHAT_ID=
VITE_TELEGRAM_EVENT_CHAT_ID=
VITE_TELEGRAM_CANCEL_CHAT_ID=

# ==============================================================================
# SERVER-ONLY VARIABLES (set in Netlify Dashboard → Site Settings → Env Vars)
# Do NOT prefix these with VITE_ — they must never reach the browser.
# ==============================================================================
# TELEGRAM_BOT_TOKEN=           (Netlify Functions only)
# TELEGRAM_ORDER_CHAT_ID=       (Netlify Functions only)
# RAZORPAY_KEY_SECRET=          (Cloudflare Workers only)
# EMAILJS_PRIVATE_KEY=          (if using EmailJS server-side)
